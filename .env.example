# Sao chép thành .env.local khi chạy trên máy, hoặc nhập trong Vercel > Settings > Environment Variables.

# Địa chỉ website (dùng cho ảnh chia sẻ Facebook/Zalo). Ví dụ: https://p-proud.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Thanh "Bản demo..." trên cùng. Đặt false khi nội dung đã được chuyên gia thẩm định.
NEXT_PUBLIC_SHOW_DEMO_BANNER=true

# Nguồn trả lời của chatbot PiPi: "scripted" = theo kịch bản (src/content/pipiScript.ts).
PIPI_PROVIDER=scripted

# Supabase (diễn đàn + đăng ký Đại sứ). Để trống thì hai form báo "đang được cài đặt".
# CHỈ dùng ở máy chủ, KHÔNG thêm tiền tố NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
